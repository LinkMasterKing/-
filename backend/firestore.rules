rules_version = '2';
// 南臺科大學生會工作看板：Cloud Firestore Security Rules（階段 01B）
// 設計依據：docs/architecture/permissions.md、invitations-roles-audit.md、booking.md、migration.md。
// 原則：預設拒絕；授權一律在這裡判斷（前端只負責顯示）；角色每次請求都從 roles/{uid} 讀（撤權立刻生效）。
// 測試：backend/tests/（權限矩陣、C-01～C-20、I-01～I-49、B-01～B-40、遷移）。
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== 共用函式 =====================
    function doc(col, id)   { return /databases/$(database)/documents/$(col)/$(id); }
    // 只接受 Google 登入且信箱已驗證（避免日後主控台多開其他登入方式時意外放行）
    function signedIn()     { return request.auth != null
                                && request.auth.token.firebase.sign_in_provider == 'google.com'
                                && request.auth.token.email_verified == true; }
    function me()           { return request.auth.uid; }
    function hasRole()      { return signedIn() && exists(doc('roles', me())); }
    function role()         { return get(doc('roles', me())).data; }
    // L1（已授權檢視者以上，D1 定案〔啟用前核准〕）：viewer、super、或任何部門角色
    function internalReader() { return hasRole() && ( role().get('viewer', false) == true
                                                   || role().get('super', false) == true
                                                   || role().get('depts', {}).size() > 0 ); }
    function isSuper()      { return hasRole() && role().get('super', false) == true; }
    function deptRole(d)    { return hasRole() ? role().get('depts', {}).get(d, null) : null; }
    function isEditor(d)    { return d is string && deptRole(d) in ['admin', 'editor']; }
    function isAdmin(d)     { return d is string && deptRole(d) == 'admin'; }
    function deptWriter(d)  { return isEditor(d) || isSuper(); }
    function deptIds()      { return ['rights', 'president', 'secretariat', 'marketing', 'finance',
                                      'events', 'affairs', 'pr', 'works', 'fruit']; }
    function d()            { return request.resource.data; }
    function stamped()      { return d().updatedAt == request.time && d().updatedBy == me(); }
    function unchanged(keys){ return !d().diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanged(keys) { return d().diff(resource.data).affectedKeys().hasOnly(keys); }
    function revNext()      { return d().rev == resource.data.rev + 1; }
    // 稽核鏈：同一批寫入裡必須新建 auditLogs/{col}_{id}_{rev}
    function auditAfter(col, id, rev) { return existsAfter(doc('auditLogs', col + '_' + id + '_' + string(rev))); }
    // 遷移：總管理員＋running 的批次（migration.md 第 3 節）
    function importing()    { return isSuper() && d().get('importBatch', null) is string
                                && get(doc('migrations', d().importBatch)).data.status == 'running'; }

    // ===================== L0 公開 =====================
    match /departments/{id} {
      allow get, list: if true;
      allow create, update: if isSuper() && id in deptIds()
        && d().keys().hasOnly(['name', 'short', 'order', 'color', 'icon', 'active', 'updatedAt', 'updatedBy'])
        && d().name is string && d().order is int && d().active is bool && stamped();
      allow delete: if isSuper();
    }
    match /org/{id} {
      allow get, list: if true;
      allow create, update: if isSuper() && id == 'config'
        && d().keys().hasOnly(['yearLabel', 'termStart', 'semester', 'updatedAt', 'updatedBy'])
        && d().semester in ['up', 'down', ''] && stamped();
      allow delete: if false;
    }

    // ===================== 使用者 =====================
    match /users/{uid} {
      allow get:  if signedIn() && (uid == me() || isSuper());
      allow list: if isSuper();
      allow create: if signedIn() && uid == me()
        && d().keys().hasOnly(['email', 'createdAt', 'lastLoginAt'])
        && d().email == request.auth.token.email
        && d().createdAt == request.time && d().lastLoginAt == request.time;
      allow update: if signedIn() && uid == me() && onlyChanged(['lastLoginAt']) && d().lastLoginAt == request.time;
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow get, list: if internalReader() || (signedIn() && uid == me());
      allow create, update: if signedIn() && (uid == me() || (isSuper() && resource != null))
        && d().keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && d().displayName is string && d().displayName.size() >= 1 && d().displayName.size() <= 40
        && d().updatedAt == request.time;
      allow delete: if false;
    }

    // ===================== 邀請（invitations-roles-audit.md 第 2、4 節） =====================
    match /invitations/{h} {
      allow get:  if isSuper() || (signedIn() && resource.data.status == 'active');
      allow list: if isSuper();
      allow delete: if false;

      function roleOk() {                                                        // viewer 邀請沒有部門
        return (d().role == 'viewer' && d().deptId == null)
            || (d().role in ['admin', 'editor'] && d().deptId is string && d().deptId in deptIds()
                && exists(doc('departments', d().deptId)));
      }
      allow create: if isSuper()                                                  // D3：只有會長室發邀請
        && h.matches('^[0-9a-f]{64}$')
        && d().keys().hasOnly(['deptId', 'role', 'legacyRef', 'boundEmail', 'note', 'status', 'rev',
                               'createdBy', 'createdAt', 'expiresAt', 'updatedAt', 'updatedBy'])
        && d().status == 'active' && d().rev == 1
        && roleOk()
        && d().createdBy == me() && d().createdAt == request.time && stamped()
        && d().expiresAt is timestamp
        && d().expiresAt > request.time && d().expiresAt <= request.time + duration.value(10, 'm')   // D13
        && auditAfter('invitations', h, 1);

      allow update: if revNext() && auditAfter('invitations', h, d().rev) && (redeem() || revoke());

      function redeem() {
        return signedIn()
          && resource.data.status == 'active' && resource.data.expiresAt > request.time
          && onlyChanged(['status', 'usedBy', 'usedAt', 'token', 'rev', 'updatedAt', 'updatedBy']) && stamped()
          && d().status == 'used' && d().usedBy == me() && d().usedAt == request.time
          && d().token is string
          && hashing.sha256(d().token).toHexString().lower() == h                 // P4：toHexString() 是大寫
          && (resource.data.get('boundEmail', null) == null || resource.data.boundEmail == request.auth.token.email)
          && getAfter(doc('roles', me())).data.lastRef == h
          && (resource.data.get('legacyRef', null) == null
              || getAfter(doc('legacyIdentities', resource.data.legacyRef)).data.claimedBy == me());
      }
      function revoke() {
        return isSuper() && resource.data.status == 'active'
          && onlyChanged(['status', 'revokedBy', 'revokedAt', 'rev', 'updatedAt', 'updatedBy']) && stamped()
          && d().status == 'revoked' && d().revokedBy == me() && d().revokedAt == request.time;
      }
    }

    // ===================== 角色 =====================
    match /roles/{uid} {
      function roleKeys()  { return ['super', 'viewer', 'depts', 'rev', 'lastVia', 'lastRef', 'updatedAt', 'updatedBy']; }
      function oldSuper()  { return resource == null ? false : resource.data.get('super', false); }
      function oldViewer() { return resource == null ? false : resource.data.get('viewer', false); }
      function oldDepts()  { return resource == null ? {} : resource.data.get('depts', {}); }
      function deptsDelta() { return d().depts.diff(oldDepts()); }
      function onlyDeptAdded(dept, r) {
        return deptsDelta().addedKeys() == [dept].toSet() && deptsDelta().changedKeys().size() == 0
            && deptsDelta().removedKeys().size() == 0 && d().depts[dept] == r;
      }
      function onlyDeptSet(dept, r) {                                             // 核准申請：新增或改成申請的角色
        return deptsDelta().affectedKeys() == [dept].toSet() && d().depts[dept] == r;
      }
      function baseShape() {
        return d().keys().hasOnly(roleKeys()) && d().depts is map
          && d().depts.keys().hasOnly(deptIds()) && d().depts.values().hasOnly(['admin', 'editor'])
          && d().get('super', false) is bool && d().get('viewer', false) is bool
          && d().lastRef is string;
      }

      // ---- 核銷邀請：本人，邀請在同一批從 active 變成 used ----
      function inv()      { return get(doc('invitations', d().lastRef)).data; }       // 批次前
      function invAfter() { return getAfter(doc('invitations', d().lastRef)).data; }  // 批次後
      function viaInvite() {
        return uid == me() && d().lastVia == 'invite' && stamped()
          && inv().status == 'active' && invAfter().status == 'used' && invAfter().usedBy == me();
      }
      function inviteGrant() {
        return d().get('super', false) == oldSuper()
          && ( (inv().role == 'viewer' && d().depts == oldDepts() && d().viewer == true && oldViewer() == false)
            || (inv().role != 'viewer' && d().get('viewer', false) == oldViewer()
                && onlyDeptAdded(inv().deptId, inv().role)) );                    // 已在該部門有角色就不能核銷
      }

      // ---- 總管理員：manual／request／revoke ----
      function superWrite() {
        return isSuper() && stamped()
          && d().lastVia in ['request', 'manual', 'revoke']
          && (uid != me() || d().get('super', false) == oldSuper())               // 不能動自己的 super
          && (d().lastVia != 'request' || viaRequest())
          && (d().lastVia != 'revoke'  || onlyRemoves());
      }
      // 核准申請＝同一批把申請從 pending 改成 approved，角色變更只包含申請的那一項
      function viaRequest() {
        let rb = get(doc('roleRequests', d().lastRef)).data;                      // 批次前
        let ra = getAfter(doc('roleRequests', d().lastRef)).data;                 // 批次後
        return rb.status == 'pending' && ra.status == 'approved' && ra.decidedBy == me()
          && rb.uid == uid
          && d().get('super', false) == oldSuper()
          && ( (rb.role == 'viewer' && d().viewer == true && d().depts == oldDepts())
            || (rb.role != 'viewer' && d().get('viewer', false) == oldViewer() && onlyDeptSet(rb.deptId, rb.role)) );
      }
      // 撤權只能拿掉部門或把 super／viewer 改成 false；降級 admin → editor 走 manual
      function onlyRemoves() {
        return deptsDelta().addedKeys().size() == 0 && deptsDelta().changedKeys().size() == 0
          && (d().get('super', false) == false || oldSuper() == true)
          && (d().get('viewer', false) == false || oldViewer() == true);
      }

      allow get:  if signedIn() && (uid == me() || isSuper());
      allow list: if isSuper();
      allow delete: if false;
      allow create: if d().rev == 1 && baseShape() && auditAfter('roles', uid, 1)
        && ((viaInvite() && inviteGrant()) || superWrite());
      allow update: if revNext() && baseShape() && auditAfter('roles', uid, d().rev)
        && ((viaInvite() && inviteGrant()) || superWrite());
    }

    // ===================== 權限申請 =====================
    match /roleRequests/{id} {
      allow get:  if signedIn() && (resource.data.uid == me() || isSuper());
      allow list: if isSuper() || (signedIn() && resource.data.uid == me());
      allow create: if signedIn() && d().uid == me() && d().status == 'pending' && d().rev == 1
        && d().keys().hasOnly(['uid', 'deptId', 'role', 'note', 'legacyRef', 'status', 'rev', 'createdAt', 'updatedAt', 'updatedBy'])
        && ( (d().role == 'viewer' && d().deptId == null)
          || (d().role in ['admin', 'editor'] && d().deptId is string && d().deptId in deptIds()
              && exists(doc('departments', d().deptId))) )
        && d().createdAt == request.time && stamped() && auditAfter('roleRequests', id, 1);
      allow update: if revNext() && auditAfter('roleRequests', id, d().rev) && stamped() && (
          (resource.data.uid == me() && resource.data.status == 'pending' && d().status == 'cancelled'
             && onlyChanged(['status', 'rev', 'updatedAt', 'updatedBy']))
       || (isSuper() && resource.data.status == 'pending' && d().status == 'rejected'
             && d().decidedBy == me() && d().decidedAt == request.time
             && onlyChanged(['status', 'decidedBy', 'decidedAt', 'rev', 'updatedAt', 'updatedBy']))
       // 核准一定要同一批把角色寫進 roles，而且 roles 的來源指向這筆申請（防「已核准但沒角色」與重放）
       || (isSuper() && resource.data.status == 'pending' && d().status == 'approved'
             && d().decidedBy == me() && d().decidedAt == request.time
             && onlyChanged(['status', 'decidedBy', 'decidedAt', 'rev', 'updatedAt', 'updatedBy'])
             && getAfter(doc('roles', resource.data.uid)).data.lastVia == 'request'
             && getAfter(doc('roles', resource.data.uid)).data.lastRef == id
             && getAfter(doc('roles', resource.data.uid)).data.updatedAt == request.time) );
      allow delete: if false;
    }

    // ===================== 稽核紀錄（只能新增，任何人都不能改、刪） =====================
    match /auditLogs/{aid} {
      function a()      { return request.resource.data; }
      function target() { return getAfter(doc(a().col, a().docId)).data; }
      function before() { return get(doc(a().col, a().docId)).data; }
      function rolesOk() {
        return a().after == { 'super': target().get('super', false), 'viewer': target().get('viewer', false), 'depts': target().depts }
          && (a().rev == 1 ? a().before == {}
                           : a().before == { 'super': before().get('super', false),
                                             'viewer': before().get('viewer', false),
                                             'depts': before().get('depts', {}) });
      }
      function statusOk() {                                                       // 有 status 的集合
        return a().after is map && a().after.status == target().status
          && (a().rev == 1 ? a().before == {} : (a().before is map && a().before.status == before().status));
      }
      allow get, list: if isSuper();
      allow update, delete: if false;
      allow create: if signedIn()
        && a().keys().hasOnly(['col', 'docId', 'rev', 'action', 'actor', 'at', 'before', 'after', 'ref'])
        && a().col in ['roles', 'invitations', 'roleRequests', 'grants', 'legacyIdentities',
                       'bookings', 'deptSettings', 'migrations']
        && a().docId is string && a().rev is int
        && aid == a().col + '_' + a().docId + '_' + string(a().rev)
        && a().actor == me() && a().at == request.time
        && target().rev == a().rev && target().updatedBy == me()
        && (a().col != 'roles' || (rolesOk() && a().action == target().lastVia && a().ref == target().lastRef))
        && (!(a().col in ['invitations', 'roleRequests', 'bookings', 'migrations']) || statusOk());
    }

    // ===================== 舊身分（決定 A4） =====================
    match /legacyIdentities/{ref} {
      allow get, list: if internalReader();
      allow create: if isSuper()
        && d().keys().hasOnly(['deptId', 'name', 'oldRole', 'createdAt', 'claimedBy', 'claimedAt', 'rev', 'updatedAt', 'updatedBy'])
        && d().rev == 1 && d().claimedBy == null && stamped() && auditAfter('legacyIdentities', ref, 1);
      allow update: if revNext() && auditAfter('legacyIdentities', ref, d().rev) && stamped()
        && onlyChanged(['claimedBy', 'claimedAt', 'rev', 'updatedAt', 'updatedBy'])
        && d().claimedAt == request.time
        && ( (resource.data.claimedBy == null && d().claimedBy == me()
              && getAfter(doc('invitations', getAfter(doc('roles', me())).data.lastRef)).data.legacyRef == ref
              && getAfter(doc('invitations', getAfter(doc('roles', me())).data.lastRef)).data.usedBy == me())
          || isSuper() );                                                          // 核准申請時認領、或修正錯誤認領
      allow delete: if isSuper();
    }

    // ===================== 部門設定 =====================
    match /deptSettings/{deptId} {
      function shape() {
        return d().keys().hasOnly(['title', 'range', 'reportBase', 'follows', 'docs', 'rev', 'updatedAt', 'updatedBy'])
          && d().title is string;
      }
      allow get, list: if internalReader();
      allow create: if isSuper() && deptId in deptIds() && shape() && d().rev == 1 && stamped()
        && auditAfter('deptSettings', deptId, 1);
      allow update: if (isAdmin(deptId) || isSuper()) && shape() && revNext() && stamped()
        && auditAfter('deptSettings', deptId, d().rev);
      allow delete: if isSuper();
    }

    // ===================== 即時回報卡片（permissions.md 第 5.1 節） =====================
    match /cards/{id} {
      function cardKeys() {
        return ['deptId', 'title', 'blocks', 'timeIds', 'issueId', 'staff', 'labels', 'links', 'report',
                'state', 'doneAt', 'deletedAt', 'deletedBy', 'order', 'round', 'roundAt', 'touched', 'touchedAt',
                'fromEv', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'legacyDesc', 'importBatch'];
      }
      function cardShape() {
        return d().keys().hasOnly(cardKeys())
          && d().keys().hasAll(['deptId', 'title', 'blocks', 'state', 'version', 'report', 'updatedAt', 'updatedBy'])
          && d().deptId in deptIds() && d().title is string && d().title.size() <= 500
          && d().blocks is list && d().state in ['open', 'done', 'deleted']
          && d().version is int && d().report is bool;
      }
      function verDoc()   { return /databases/$(database)/documents/cards/$(id)/versions/$(string(d().version)); }
      // 版本一定要「在這一批新建」，不接受已存在的舊版本（C-12）
      function verAfter() { return !exists(verDoc()) && existsAfter(verDoc()); }
      function stateMove() {
        let o = resource.data.state;
        let n = d().state;
        return (o == n && unchanged(['doneAt', 'deletedAt', 'deletedBy']))
          || (o == 'open' && n == 'done' && d().doneAt == request.time)
          || (o == 'done' && n == 'open' && d().doneAt == null)
          || (o in ['open', 'done'] && n == 'deleted' && d().deletedAt == request.time && d().deletedBy == me())
          || (o == 'deleted' && n == 'open' && d().deletedAt == null && d().deletedBy == null);
      }
      function editorEdit()  { return deptWriter(resource.data.deptId) && stamped()
                                 && d().version == resource.data.version + 1 && verAfter() && stateMove(); }
      // 秘書處會議編輯：報告事項、授權未到期、只改內容
      function meetingEdit() { return isEditor('secretariat') && resource.data.report == true
                                 && get(doc('grants', 'meetingEdit')).data.until > request.time
                                 && onlyChanged(['title', 'blocks', 'timeIds', 'version', 'updatedAt', 'updatedBy'])
                                 && stamped() && d().version == resource.data.version + 1 && verAfter(); }
      function reorder()     { return deptWriter(resource.data.deptId)
                                 && onlyChanged(['order', 'updatedAt', 'updatedBy']) && stamped(); }
      function normalCreate() {
        return deptWriter(d().deptId) && !d().keys().hasAny(['importBatch', 'legacyDesc'])
          && d().state == 'open' && d().version == 1
          && d().createdBy == me() && d().createdAt == request.time && stamped();
      }
      function importCreate() {                                                   // 遷移：帶舊時間、createdBy 'legacy:import'
        return importing() && d().state in ['open', 'done'] && d().version == 1
          && d().createdBy == 'legacy:import' && (d().createdAt == null || d().createdAt is timestamp)
          && stamped();
      }

      allow get:  if internalReader() && (resource.data.state != 'deleted' || deptWriter(resource.data.deptId));
      allow list: if internalReader() && (resource.data.state in ['open', 'done'] || deptWriter(resource.data.deptId));
      allow create: if cardShape() && (normalCreate() || importCreate()) && verAfter();
      allow update: if cardShape() && unchanged(['deptId', 'createdAt', 'createdBy', 'importBatch', 'legacyDesc'])
        && (editorEdit() || meetingEdit() || reorder());
      allow delete: if isSuper();

      // 版本歷史：子集合，讀取條件跟母卡片相同；只能隨卡片新增
      match /versions/{v} {
        function card()      { return get(doc('cards', id)).data; }
        function cardAfter() { return getAfter(doc('cards', id)).data; }
        function nv()        { return request.resource.data; }
        function sameAsCard() {
          return nv().keys().hasOnly(['cardId', 'deptId', 'version', 'title', 'blocks', 'times', 'state', 'by', 'at', 'imported', 'importBatch'])
            && nv().cardId == id && v == string(nv().version)
            && cardAfter().version == nv().version
            && nv().deptId == cardAfter().deptId
            && nv().title  == cardAfter().title
            && nv().blocks == cardAfter().blocks
            && nv().state  == cardAfter().state
            && nv().by == me() && nv().by == cardAfter().updatedBy
            && nv().at == request.time && nv().at == cardAfter().updatedAt;
        }
        // 遷移產生的第 1 版：總管理員、卡片在同一批以 running 批次新建
        function importVersion() {
          return nv().imported == true && nv().version == 1 && isSuper() && !exists(doc('cards', id))
            && cardAfter().get('importBatch', null) is string && nv().get('importBatch', null) == cardAfter().importBatch
            && get(doc('migrations', cardAfter().importBatch)).data.status == 'running';
        }
        allow get, list: if isSuper()
          || (internalReader() && exists(doc('cards', id))
              && (card().state != 'deleted' || isEditor(card().deptId)));
        allow create: if signedIn() && sameAsCard()
          && ((nv().imported == false && !nv().keys().hasAny(['importBatch'])) || importVersion());
        allow update: if false;
        // 版本歷史不能修改、不能刪除（含總管理員、含一般的卡片硬刪）。
        // 唯一例外是遷移失敗回復（R1，使用者 2026-11-11 決定）：只限
        //   ① 遷移產生的第 1 版（imported == true）且標記了批次 importBatch；
        //   ② 那個批次已經由總管理員改成 rollingBack（有稽核紀錄；只有 running／failed 的批次能進入回復）；
        //   ③ 母卡片也是同一個批次匯入、匯入後沒被改過（version == 1），而且在同一批被刪掉。
        // 被使用者改過的卡片（版本 ≥ 2）、一般版本、正常業務資料都不適用。
        allow delete: if isSuper() && resource.data.imported == true
          && resource.data.get('importBatch', null) is string
          && get(doc('migrations', resource.data.importBatch)).data.status == 'rollingBack'
          && exists(doc('cards', id)) && card().get('importBatch', null) == resource.data.importBatch
          && card().version == 1
          && !existsAfter(doc('cards', id));
      }
    }

    // 跨卡片查詢（會長室編輯量 Q9）：只開放給總管理員與該部門編輯者
    match /{path=**}/versions/{v} {
      allow list: if isSuper() || isEditor(resource.data.deptId);
    }

    // ===================== 母議題、週報、標籤 =====================
    match /issues/{id} {
      function shape() {
        return d().keys().hasOnly(['deptId', 'title', 'cur', 'start', 'end', 'startAt', 'endAt', 'note', 'tags', 'labels',
                                   'links', 'staff', 'markers', 'doneAt', 'order', 'rev', 'updatedAt', 'updatedBy', 'importBatch'])
          && d().deptId in deptIds() && d().title is string;
      }
      allow get, list: if internalReader();
      allow create: if shape() && deptWriter(d().deptId) && d().rev == 1 && stamped();
      allow update: if shape() && deptWriter(resource.data.deptId) && unchanged(['deptId', 'importBatch']) && revNext() && stamped();
      allow delete: if isSuper();
    }
    match /weeks/{id} {
      function shape() {
        return d().keys().hasOnly(['deptId', 'date', 'text', 'auto', 'createdAt', 'updatedAt', 'updatedBy', 'importBatch'])
          && d().deptId in deptIds() && d().text is string;
      }
      allow get, list: if internalReader();
      allow create: if shape() && deptWriter(d().deptId) && d().createdAt == request.time && stamped();
      allow update: if shape() && deptWriter(resource.data.deptId) && unchanged(['deptId', 'createdAt', 'importBatch']) && stamped();
      allow delete: if isSuper();
    }
    match /labels/{id} {
      function shape() {
        return d().keys().hasOnly(['deptId', 'kind', 'name', 'updatedAt', 'updatedBy', 'importBatch'])
          && d().deptId in deptIds() && d().name is string;
      }
      allow get, list: if internalReader();
      allow create: if shape() && deptWriter(d().deptId) && stamped();
      allow update: if shape() && deptWriter(resource.data.deptId) && unchanged(['deptId', 'importBatch']) && stamped();
      allow delete: if isSuper();
    }

    // ===================== 時間事件（permissions.md 第 5.2 節） =====================
    match /events/{id} {
      function eventKeys() {
        return ['deptId', 'cardId', 'blockId', 'label', 'start', 'end', 'startRaw', 'endRaw', 'allDay', 'place',
                'toIssue', 'cardDeleted', 'scope', 'visibility', 'title', 'summary', 'rev', 'updatedAt', 'updatedBy', 'importBatch'];
      }
      function eventShape() {
        return d().keys().hasOnly(eventKeys())
          && d().keys().hasAll(['deptId', 'start', 'end', 'allDay', 'cardDeleted', 'scope', 'visibility', 'rev', 'updatedAt', 'updatedBy'])
          && d().deptId in deptIds() && d().start is timestamp && d().end is timestamp && d().end >= d().start
          && d().allDay is bool && d().cardDeleted is bool
          && d().scope in ['dept', 'all-activity', 'all-meeting'] && d().visibility in ['internal', 'public'];
      }
      // 公開事件整份對外公開：只能有公開欄位，不放卡片內文
      function publicShape() {
        return d().keys().hasOnly(['deptId', 'title', 'summary', 'start', 'end', 'allDay', 'place', 'scope', 'visibility',
                                   'cardDeleted', 'rev', 'updatedAt', 'updatedBy'])
          && d().title is string && d().cardDeleted == false;
      }
      function scopeOk() { return d().scope == (resource == null ? 'dept' : resource.data.scope)
                               || d().scope == 'dept'
                               || (d().scope == 'all-activity' && isEditor('events'))
                               || (d().scope == 'all-meeting'  && isEditor('secretariat'))
                               || isSuper(); }
      function visOk()   { return d().visibility == 'internal'
                               || ((isEditor('events') || isSuper()) && publicShape()); }   // D4
      // D14：cardDeleted 必須等於批次後母卡片是否已刪除
      function cardOk()  { return d().get('cardId', null) == null
                               || !existsAfter(doc('cards', d().cardId))
                               || d().cardDeleted == (getAfter(doc('cards', d().cardId)).data.state == 'deleted'); }
      function meetingEditOfReportedCard() {
        return isEditor('secretariat') && resource.data.get('cardId', null) is string
          && get(doc('cards', resource.data.cardId)).data.report == true
          && get(doc('grants', 'meetingEdit')).data.until > request.time
          && onlyChanged(['label', 'start', 'end', 'startRaw', 'endRaw', 'allDay', 'place', 'toIssue', 'rev', 'updatedAt', 'updatedBy']);
      }

      allow get, list: if resource.data.visibility == 'public'
        || (internalReader() && (resource.data.get('cardDeleted', false) == false
                                 || deptWriter(resource.data.deptId)));
      allow create: if deptWriter(d().deptId) && eventShape() && scopeOk() && visOk() && cardOk()
        && d().rev == 1 && stamped();
      allow update: if eventShape() && unchanged(['deptId', 'importBatch']) && stamped() && revNext() && (
             (deptWriter(resource.data.deptId) && scopeOk() && visOk() && cardOk())
          || (isEditor('events')      && onlyChanged(['scope', 'rev', 'updatedAt', 'updatedBy'])
                                      && d().scope in ['dept', 'all-activity'])
          || (isEditor('secretariat') && onlyChanged(['scope', 'rev', 'updatedAt', 'updatedBy'])
                                      && d().scope in ['dept', 'all-meeting'])
          || meetingEditOfReportedCard() );
      allow delete: if isSuper();
    }

    // ===================== 秘書處會議編輯授權 =====================
    match /grants/{gid} {
      allow get, list: if internalReader();
      allow create, update: if isSuper() && gid == 'meetingEdit'
        && d().keys().hasOnly(['until', 'by', 'at', 'rev', 'updatedAt', 'updatedBy'])
        && d().until is timestamp && d().until <= request.time + duration.value(7, 'd')
        && (resource == null ? d().rev == 1 : revNext())
        && stamped() && auditAfter('grants', gid, d().rev);
      allow delete: if false;
    }

    // ===================== L3 秘書處授權 =====================
    match /meetingMinutes/{date} {
      allow read, create, update: if isEditor('secretariat') || isSuper();
      allow delete: if isSuper();
    }
    match /attendanceMembers/{id} {
      allow read, create, update: if isEditor('secretariat') || isSuper();
      allow delete: if isSuper();
    }
    match /attendanceSessions/{id} {
      allow read, create, update: if isEditor('secretariat') || isSuper();
      allow delete: if isSuper();
    }
    match /attendanceRecords/{id} {
      allow read, create, update: if isEditor('secretariat') || isSuper();
      allow delete: if isSuper();
    }

    // ===================== 遷移批次 =====================
    match /migrations/{batch} {
      allow get, list: if isSuper();
      allow create: if isSuper()
        && d().keys().hasOnly(['status', 'sourceCommit', 'fileHashes', 'counts', 'report', 'startedBy', 'startedAt',
                               'finishedAt', 'rev', 'updatedAt', 'updatedBy'])
        && d().status == 'running' && d().rev == 1
        && d().startedBy == me() && d().startedAt == request.time && stamped()
        && auditAfter('migrations', batch, 1);
      // 狀態：running →（running｜done｜failed｜rollingBack）；failed → rollingBack；rollingBack → rolledBack。
      // done 之後不能再寫入、也不能回復；只有 running 能用來寫入（importing()），只有 rollingBack 能刪遷移版本。
      allow update: if isSuper()
        && ( (resource.data.status == 'running' && d().status in ['running', 'done', 'failed', 'rollingBack'])
          || (resource.data.status == 'failed' && d().status == 'rollingBack')
          || (resource.data.status == 'rollingBack' && d().status == 'rolledBack') )
        && unchanged(['startedBy', 'startedAt']) && revNext() && stamped()
        && auditAfter('migrations', batch, d().rev);
      allow delete: if false;
    }

    // ===================== 會長預約（booking.md） =====================
    function cal(o)       { return get(doc('calendars', o)).data; }
    function isManager(o) { return signedIn() && o is string && exists(doc('calendars', o)) && me() in cal(o).managers; }
    function slotDoc(o, i){ return doc('slots', o + '_' + string(i)); }
    // D6：有部門角色的人才能申請
    function hasDeptRole(){ return hasRole() && role().get('depts', {}).size() > 0; }

    match /calendars/{ownerId} {
      allow get, list: if internalReader();
      allow create, update: if isSuper()
        && d().keys().hasOnly(['name', 'managers', 'gridMin', 'maxSlots', 'horizonDays', 'maxPendingPerUser', 'rev', 'updatedAt', 'updatedBy'])
        && d().managers is list && stamped();
      allow delete: if false;
    }
    match /openWindows/{wid} {
      function aligned() { return d().start.toMillis() % 1800000 == 0 && d().end.toMillis() % 1800000 == 0 && d().start < d().end; }
      allow get, list: if internalReader();
      allow create, update: if (isManager(d().ownerId) || isSuper())
        && d().keys().hasOnly(['ownerId', 'start', 'end', 'updatedAt', 'updatedBy'])
        && (resource == null || d().ownerId == resource.data.ownerId)
        && d().start is timestamp && d().end is timestamp && aligned() && stamped();
      allow delete: if isManager(resource.data.ownerId) || isSuper();
    }

    match /slots/{sid} {
      function s() { return request.resource.data; }
      allow get, list: if internalReader();
      allow update: if false;                                                     // P1：同一格只能建立一次
      allow create: if signedIn()
        && s().keys().hasOnly(['ownerId', 'idx', 'ref'])
        && s().idx is int && s().ref is string
        && sid == s().ownerId + '_' + string(s().idx)
        && ( bookingCovers() || busyCovers() );
      function bookingCovers() {
        let b = getAfter(doc('bookings', s().ref)).data;
        return b.requester == me() && b.ownerId == s().ownerId && b.status == 'pending'
            && s().idx >= b.startSlot && s().idx < b.startSlot + b.slotCount;
      }
      function busyCovers() {
        let x = getAfter(doc('busyBlocks', s().ref)).data;
        return isManager(s().ownerId) && x.ownerId == s().ownerId && x.status == 'active'
            && s().idx >= x.startSlot && s().idx < x.startSlot + x.slotCount;
      }
      // 刪鎖只看「擁有者在批次後是否已經釋放」，不看誰在刪
      function r() { return resource.data; }
      function covers(x) { return x.ownerId == r().ownerId && r().idx >= x.startSlot && r().idx < x.startSlot + x.slotCount; }
      function bookingReleased() {
        return existsAfter(doc('bookings', r().ref))
            && covers(getAfter(doc('bookings', r().ref)).data)
            && getAfter(doc('bookings', r().ref)).data.status in ['rejected', 'cancelled'];
      }
      function busyReleased() {
        return !existsAfter(doc('bookings', r().ref))
            && existsAfter(doc('busyBlocks', r().ref))
            && covers(getAfter(doc('busyBlocks', r().ref)).data)
            && getAfter(doc('busyBlocks', r().ref)).data.status == 'released';
      }
      function orphan() {                                                         // 只會因主控台誤刪出現
        return isManager(r().ownerId)
            && !existsAfter(doc('bookings', r().ref)) && !existsAfter(doc('busyBlocks', r().ref));
      }
      allow delete: if signedIn() && (bookingReleased() || busyReleased() || orphan());
    }

    match /busyBlocks/{xid} {
      function x() { return request.resource.data; }
      function claimed(i) { return getAfter(slotDoc(x().ownerId, i)).data.ref == xid; }
      function claimsAll() {
        let s = x().startSlot;
        let n = x().slotCount;
        return claimed(s) && (n < 2 || claimed(s + 1)) && (n < 3 || claimed(s + 2)) && (n < 4 || claimed(s + 3));
      }
      function released() {
        let s = resource.data.startSlot;
        let n = resource.data.slotCount;
        let o = resource.data.ownerId;
        return !existsAfter(slotDoc(o, s)) && (n < 2 || !existsAfter(slotDoc(o, s + 1)))
            && (n < 3 || !existsAfter(slotDoc(o, s + 2))) && (n < 4 || !existsAfter(slotDoc(o, s + 3)));
      }
      allow get, list: if isManager(resource.data.ownerId);
      allow delete: if false;                                                     // 釋放一定走 status → released
      allow create: if isManager(x().ownerId)
        && x().keys().hasOnly(['ownerId', 'title', 'start', 'end', 'startSlot', 'slotCount', 'status', 'rev',
                               'createdAt', 'updatedAt', 'updatedBy'])
        && x().status == 'active' && x().rev == 1
        && x().startSlot is int && x().slotCount is int && x().slotCount >= 1 && x().slotCount <= 4
        && x().start.toMillis() == x().startSlot * 1800000
        && x().end.toMillis()   == (x().startSlot + x().slotCount) * 1800000
        && x().createdAt == request.time && stamped()
        && claimsAll();
      allow update: if isManager(resource.data.ownerId) && revNext() && stamped()
        && unchanged(['ownerId', 'start', 'end', 'startSlot', 'slotCount', 'createdAt'])
        && ( (resource.data.status == 'active' && x().status == 'active' && onlyChanged(['title', 'rev', 'updatedAt', 'updatedBy']))
          || (resource.data.status == 'active' && x().status == 'released' && released()) );
    }

    match /bookings/{bid} {
      function b() { return request.resource.data; }
      function claimed(i) { return getAfter(slotDoc(b().ownerId, i)).data.ref == bid; }
      function claimsAll() {                                                      // 規則沒有迴圈：上限 4 格就展開 4 次
        let s = b().startSlot;
        let n = b().slotCount;
        return claimed(s) && (n < 2 || claimed(s + 1)) && (n < 3 || claimed(s + 2)) && (n < 4 || claimed(s + 3));
      }
      function released() {
        let s = resource.data.startSlot;
        let n = resource.data.slotCount;
        let o = resource.data.ownerId;
        return !existsAfter(slotDoc(o, s)) && (n < 2 || !existsAfter(slotDoc(o, s + 1)))
            && (n < 3 || !existsAfter(slotDoc(o, s + 2))) && (n < 4 || !existsAfter(slotDoc(o, s + 3)));
      }
      function inWindow() {
        let w = get(doc('openWindows', b().windowId)).data;
        return w.ownerId == b().ownerId && w.start <= b().start && b().end <= w.end;
      }
      allow get, list: if signedIn() && (resource.data.requester == me() || isManager(resource.data.ownerId));
      allow delete: if false;

      allow create: if hasDeptRole() && b().requester == me() && b().status == 'pending' && b().rev == 1
        && b().keys().hasOnly(['ownerId', 'requester', 'windowId', 'startSlot', 'slotCount', 'start', 'end', 'topic', 'note',
                               'status', 'rev', 'createdAt', 'updatedAt', 'updatedBy', 'decidedBy'])
        && b().startSlot is int && b().slotCount is int && b().slotCount >= 1 && b().slotCount <= 4
        && b().start.toMillis() == b().startSlot * 1800000                       // 對齊格線
        && b().end.toMillis()   == (b().startSlot + b().slotCount) * 1800000
        && b().start > request.time && b().start < request.time + duration.value(60, 'd')
        && inWindow()
        && claimsAll()
        && getAfter(doc('bookingQuota', b().ownerId + '_' + me())).data.pending <= 3    // D6：每人最多 3 筆
        && b().createdAt == request.time && stamped()
        && auditAfter('bookings', bid, 1);

      allow update: if revNext() && stamped() && auditAfter('bookings', bid, b().rev)
        && unchanged(['ownerId', 'requester', 'windowId', 'startSlot', 'slotCount', 'start', 'end', 'createdAt'])
        && ( (isManager(resource.data.ownerId) && resource.data.status == 'pending' && b().status == 'approved'
                && onlyChanged(['status', 'decidedBy', 'rev', 'updatedAt', 'updatedBy']) && b().decidedBy == me())
          || (isManager(resource.data.ownerId) && resource.data.status in ['pending', 'approved']
                && b().status == 'rejected' && released()
                && onlyChanged(['status', 'decidedBy', 'rev', 'updatedAt', 'updatedBy']) && b().decidedBy == me())
          || (resource.data.requester == me() && resource.data.status in ['pending', 'approved']
                && b().status == 'cancelled' && released()
                && onlyChanged(['status', 'rev', 'updatedAt', 'updatedBy'])) );
    }

    // 每人每個行事曆「未釋放的預約數」：只能隨預約一起 +1／−1（不是安全邊界，只防佔位）
    match /bookingQuota/{qid} {
      function q() { return request.resource.data; }
      function bk()      { return get(doc('bookings', q().lastRef)).data; }
      function bkAfter() { return getAfter(doc('bookings', q().lastRef)).data; }
      function shape() { return q().keys().hasOnly(['ownerId', 'uid', 'pending', 'lastRef'])
                           && qid == q().ownerId + '_' + q().uid && q().pending is int && q().pending >= 0; }
      // +1：同一批新建了自己的 pending 預約
      function added()   { return q().uid == me() && !exists(doc('bookings', q().lastRef))
                             && bkAfter().requester == me() && bkAfter().ownerId == q().ownerId && bkAfter().status == 'pending'; }
      // −1：同一批把這個人的預約從 pending／approved 改成 rejected／cancelled
      function removed() { return bk().requester == q().uid && bk().ownerId == q().ownerId && bk().status in ['pending', 'approved']
                             && bkAfter().status in ['rejected', 'cancelled']; }
      allow get, list: if signedIn() && (resource.data.uid == me() || isManager(resource.data.ownerId));
      allow create: if signedIn() && shape() && q().pending == 1 && added();
      allow update: if signedIn() && shape() && unchanged(['ownerId', 'uid'])
        && ( (q().pending == resource.data.pending + 1 && added())
          || (q().pending == resource.data.pending - 1 && removed()) );
      allow delete: if false;
    }

    // ===================== 其他：預設拒絕 =====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
